# Your client's live domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourclientdomain.com

# NGF app URL — only change if using a custom NGF deployment
NGF_APP_URL=https://app.ngfsystems.com

# Must match WEBSITE_REVALIDATION_SECRET in NGF Systems app Vercel env vars
WEBSITE_REVALIDATION_SECRET=your-secret-here

# Google Analytics 4 measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=

# Google Search Console — ONLY needed for the HTML-tag verification method.
# Leave blank when the property was verified by DNS TXT (the preferred method).
# See NGF-STANDARDS "Google Search Console — per-site setup runbook".
GOOGLE_SITE_VERIFICATION=
