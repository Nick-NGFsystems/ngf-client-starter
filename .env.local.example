# Your client's live domain — BARE HOSTNAME. No protocol, no www., no trailing slash.
# ✅ acme.com     ✅ acme-mockup.vercel.app     ❌ https://acme.com/
# sitemap.ts, robots.ts, metadataBase and the JSON-LD builders all interpolate this
# as `https://${value}`, so a protocol here ships https://https://acme.com into your
# canonical tags and sitemap. Must match client_configs.site_url in the NGF admin.
NEXT_PUBLIC_SITE_URL=yourclientdomain.com

# NGF app URL — only change if using a custom NGF deployment
NGF_APP_URL=https://app.ngfsystems.com

# Must match WEBSITE_REVALIDATION_SECRET in NGF Systems app Vercel env vars
WEBSITE_REVALIDATION_SECRET=your-secret-here

# Google Analytics 4 measurement ID (starts with G-). Leave blank for no analytics.
NEXT_PUBLIC_GA_ID=

# REQUIRED whenever NEXT_PUBLIC_GA_ID is set. GA4 sets cookies, so it is gated behind
# hasCookieConsent() — and the consent banner only renders when this is "1".
# Set GA without this and the banner never appears, consent can never be granted,
# and analytics silently never load. Leave BOTH blank for a site with no cookie-based
# analytics; cookieless (Vercel Analytics) needs no consent and no banner.
NEXT_PUBLIC_COOKIE_ANALYTICS=

# Google Search Console — ONLY needed for the HTML-tag verification method.
# Leave blank when the property was verified by DNS TXT (the preferred method).
# See NGF-STANDARDS "Google Search Console — per-site setup runbook".
GOOGLE_SITE_VERIFICATION=
